@media (min-width: 901px) {
  .activity-workspace-list-only .activity-sidebar { width: 360px !important; flex-basis: 360px !important; }
  .activity-workspace-list-only .activity-filter-panel { margin: 12px 10px 12px 14px !important; padding: 18px 16px 20px !important; }
}
.activity-list-expand-toggle { position: absolute; z-index: 45; top: 50%; display: grid; width: 34px; height: 54px; flex: 0 0 34px; place-items: center; transform: translateY(-50%); border: 1px solid var(--border); background: var(--surface); color: var(--foreground); box-shadow: 0 4px 18px rgb(0 0 0 / 20%); transition: background .18s ease, color .18s ease, box-shadow .18s ease; }
.activity-list-expand-toggle:hover { width: 34px; transform: translateY(-50%); background: #047857; color: #fff; box-shadow: 0 6px 20px rgb(0 0 0 / 26%); }
.activity-list-expand-toggle.is-expanded { right: -1px; border-radius: 12px 0 0 12px; }
.activity-list-expand-toggle.is-collapsed { right: 0; border-radius: 12px 0 0 12px; }
