/* v13: wider filter/create-activity card; remove the divider rail and keep the arrow fixed on hover. */
.activity-sidebar { background: transparent !important; border-right: 0 !important; }
.activity-sidebar .activity-filter-panel { margin: 12px 10px 12px 14px !important; border: 1px solid var(--border) !important; border-radius: 16px !important; background: var(--surface) !important; box-shadow: 0 8px 24px rgb(0 0 0 / 10%) !important; padding: 18px 16px 20px !important; }
.activity-sidebar .activity-filter-panel h1 { font-size: 1.2rem; line-height: 1.35; }
.activity-sidebar .activity-filter-panel .grid-cols-2 button { min-width: 0; white-space: normal; line-height: 1.25; padding: 9px 5px; }
