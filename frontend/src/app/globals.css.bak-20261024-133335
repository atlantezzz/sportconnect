@media (max-width: 900px) {
  .activity-sidebar .activity-filter-panel { margin: 8px !important; padding: 12px !important; }
  .activity-list-expand-toggle, .activity-list-expand-toggle:hover { width: 30px; height: 46px; transform: translateY(-50%); }
}


