/* v17: persistent chat hub with WhatsApp-style latest-message previews. */
.chat-hub-root { position:fixed; right:max(1rem,env(safe-area-inset-right)); bottom:max(1rem,env(safe-area-inset-bottom)); z-index:130; display:flex; flex-direction:column; align-items:flex-end; gap:12px; }
.chat-hub-button { display:grid; width:56px; height:56px; place-items:center; border:2px solid #047857; border-radius:999px; background:#047857; color:#fff; box-shadow:0 12px 32px rgb(0 0 0 / 28%); transition:background-color .18s,border-color .18s,box-shadow .18s; }
.chat-hub-button:hover { background:#059669; border-color:#059669; }
.chat-hub-panel { width:min(440px,calc(100vw - 28px)); max-height:min(72vh,680px); display:flex; flex-direction:column; overflow:hidden; border:1px solid var(--border); border-radius:20px; color:var(--foreground); background:var(--surface); box-shadow:0 24px 70px rgb(0 0 0 / 32%); }
.chat-hub-heading { display:flex; align-items:center; justify-content:space-between; padding:16px 18px; background:var(--header); color:#fff; }
.chat-hub-heading h2 { font-size:1.05rem; font-weight:800; }
.chat-hub-heading p { margin-top:2px; font-size:11px; color:#c9d7cd; }
.chat-hub-heading button { display:grid; width:32px; height:32px; place-items:center; border-radius:999px; font-size:24px; color:#fff; }
.chat-hub-list { overflow-y:auto; padding:7px; }
.chat-hub-item { display:flex; width:100%; min-width:0; align-items:center; gap:11px; padding:12px 10px; text-align:left; border-bottom:1px solid var(--border); color:var(--foreground); transition:background-color .15s; }
.chat-hub-item:hover { background:var(--surface-muted); }
.chat-hub-avatar { display:grid; flex:0 0 42px; width:42px; height:42px; place-items:center; border-radius:50%; background:#dff7ec; color:#047857; font-size:15px; font-weight:800; }
.chat-hub-avatar.is-group { border-radius:14px; background:#047857; color:#fff; }
.chat-hub-copy { display:flex; min-width:0; flex:1; flex-direction:column; gap:2px; }
.chat-hub-title { overflow:hidden; color:var(--foreground); font-size:13px; font-weight:750; text-overflow:ellipsis; white-space:nowrap; }
.chat-hub-subtitle { overflow:hidden; color:var(--muted); font-size:10px; text-overflow:ellipsis; white-space:nowrap; }
.chat-hub-preview { overflow:hidden; color:var(--muted); font-size:12px; text-overflow:ellipsis; white-space:nowrap; }
.chat-hub-kind { align-self:flex-start; flex-shrink:0; border:1px solid var(--border); border-radius:999px; padding:3px 6px; color:var(--muted); font-size:9px; }
.chat-hub-empty { padding:28px 18px; color:var(--muted); text-align:center; font-size:13px; line-height:1.6; }
.chat-hub-footer { border-top:1px solid var(--border); padding:10px; }
.chat-hub-footer button { display:flex; width:100%; justify-content:space-between; align-items:center; border-radius:10px; padding:10px 12px; color:#fff; background:#047857; font-size:12px; font-weight:700; }
@media(min-width:901px) {
  .activity-workspace-map-list .activity-sidebar, .activity-workspace-list-only .activity-sidebar { width:440px !important; flex-basis:440px !important; }
  .activity-sidebar .activity-filter-panel { padding:20px 18px 22px !important; }
}
@media(max-width:600px) { .chat-hub-panel { max-height:68vh; } .chat-hub-kind { display:none; } }
